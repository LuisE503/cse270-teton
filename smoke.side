{
  "id": "cse270-smoke-test",
  "version": "2.0",
  "name": "Smoke Test",
  "url": "http://127.0.0.1:5500/teton/1.6/",
  "tests": [
    {
      "id": "test-logo-header-title",
      "name": "Test 1 - Logo Header and Title",
      "commands": [
        {"id": "t1-1", "command": "open", "target": "index.html", "value": ""},
        {"id": "t1-2", "command": "assertElementPresent", "target": "css=.header-logo img", "value": ""},
        {"id": "t1-3", "command": "assertText", "target": "css=footer h3", "value": "Teton Idaho Chamber of Commerce"},
        {"id": "t1-4", "command": "assertTitle", "target": "", "value": "Teton Idaho CoC"}
      ]
    },
    {
      "id": "test-home-spotlights-join",
      "name": "Test 2 - Home Page Spotlights and Join",
      "commands": [
        {"id": "t2-1", "command": "open", "target": "index.html", "value": ""},
        {"id": "t2-2", "command": "setWindowSize", "target": "1440x1000", "value": ""},
        {"id": "t2-3", "command": "waitForElementPresent", "target": "css=.main-spotlight > div:nth-child(2)", "value": "10000"},
        {"id": "t2-4", "command": "assertElementPresent", "target": "css=.main-hero a[href='join.html']", "value": ""},
        {"id": "t2-5", "command": "click", "target": "css=.main-hero a[href='join.html']", "value": ""},
        {"id": "t2-6", "command": "assertLocation", "target": "join.html", "value": ""}
      ]
    },
    {
      "id": "test-directory-grid-list",
      "name": "Test 3 - Directory Grid and List",
      "commands": [
        {"id": "t3-1", "command": "open", "target": "directory.html", "value": ""},
        {"id": "t3-2", "command": "waitForText", "target": "id=directory-data", "value": "Teton Turf and Tree"},
        {"id": "t3-3", "command": "click", "target": "id=directory-grid", "value": ""},
        {"id": "t3-4", "command": "assertText", "target": "id=directory-data", "value": "*Teton Turf and Tree*"},
        {"id": "t3-5", "command": "click", "target": "id=directory-list", "value": ""},
        {"id": "t3-6", "command": "assertText", "target": "id=directory-data", "value": "*Teton Turf and Tree*"}
      ]
    },
    {
      "id": "test-join-data-entry",
      "name": "Test 4 - Join Page Data Entry",
      "commands": [
        {"id": "t4-1", "command": "open", "target": "join.html", "value": ""},
        {"id": "t4-2", "command": "assertElementPresent", "target": "name=fname", "value": ""},
        {"id": "t4-3", "command": "type", "target": "name=fname", "value": "Ada"},
        {"id": "t4-4", "command": "type", "target": "name=lname", "value": "Lovelace"},
        {"id": "t4-5", "command": "type", "target": "name=bizname", "value": "Analytical Engines"},
        {"id": "t4-6", "command": "type", "target": "name=biztitle", "value": "Founder"},
        {"id": "t4-7", "command": "click", "target": "css=input[type='submit']", "value": ""},
        {"id": "t4-8", "command": "assertElementPresent", "target": "name=email", "value": ""}
      ]
    },
    {
      "id": "test-admin-invalid-login",
      "name": "Test 5 - Admin Invalid Username and Password",
      "commands": [
        {"id": "t5-1", "command": "open", "target": "admin.html", "value": ""},
        {"id": "t5-2", "command": "type", "target": "id=username", "value": "not-a-user"},
        {"id": "t5-3", "command": "type", "target": "id=password", "value": "not-a-password"},
        {"id": "t5-4", "command": "click", "target": "css=input[value='Login']", "value": ""},
        {"id": "t5-5", "command": "assertText", "target": "css=.errorMessage", "value": "Invalid username and password."}
      ]
    }
  ],
  "suites": [
    {
      "id": "smoke-suite",
      "name": "Smoke Tests",
      "parallel": false,
      "tests": [
        "test-logo-header-title",
        "test-home-spotlights-join",
        "test-directory-grid-list",
        "test-join-data-entry",
        "test-admin-invalid-login"
      ]
    }
  ],
  "urls": ["http://127.0.0.1:5500/teton/1.6/"],
  "plugins": []
}
